					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT year, month\nFROM dbo.green_taxi_control\nWHERE enabled = 1\nORDER BY year, month",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable",
						"type": "DatasetReference",
						"parameters": {
							"database_server_name": {
								"value": "@pipeline().parameters.p_DatabaseServerName",
								"type": "Expression"
							},
							"database_name": {
								"value": "@pipeline().parameters.p_DatabaseName",
								"type": "Expression"
							},
							"database_user_name": {
								"value": "@pipeline().parameters.p_DatabaseUserName",
								"type": "Expression"
							},
							"key_vault_name": {
								"value": "@pipeline().parameters.p_KeyVaultName",
								"type": "Expression"
							},
							"database_password_secret_name": {
								"value": "@pipeline().parameters.kv_DatabasePasswordSecretName",
								"type": "Expression"
