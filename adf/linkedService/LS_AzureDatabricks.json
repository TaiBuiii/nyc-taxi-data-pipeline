{
	"name": "LS_AzureDatabricks",
	"properties": {
		"parameters": {
			"key_vault_name": {
				"type": "string",
				"defaultValue": "keyvault-nyc-taxi"
			},
			"databricks_workspace": {
				"type": "string"
			},
			"databricks_access_token_name": {
				"type": "string"
			},
			"cluster_id": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "AzureDatabricks",
		"typeProperties": {
			"domain": "@linkedService().databricks_workspace",
			"accessToken": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_AzureKeyVault",
					"type": "LinkedServiceReference",
					"parameters": {
						"key_vault_name": {
							"value": "@linkedService().key_vault_name",
							"type": "Expression"
						}
					}
				},
				"secretName": {
					"value": "@linkedService().databricks_access_token_name",
					"type": "Expression"
				}
			},
			"existingClusterId": "@linkedService().cluster_id"
		}
	}
}